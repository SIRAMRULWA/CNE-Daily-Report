# Work Order Report - environment template
#
# Copy to .env (local) or /opt/wo-report-stack/shared/.env (QA/production),
# chmod 600, and replace every <placeholder>. Never commit the real file.
# Do not reuse any secret from the Daily Report app.

# Runtime, logging, and pipeline
ENVIRONMENT=dev
WORKSPACE_TIMEZONE=Africa/Johannesburg
RUNTIME_SCHEMA_BOOTSTRAP_ENABLED=false
API_WORKERS=1
EXCEL_DROP_DIR=./data/excel_drop
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
PIPELINE_WEEKDAYS_ONLY=false
PIPELINE_SCHEDULE_HOUR=7
DATA_RETENTION_DAYS=7

# API and authentication
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
JWT_SECRET=<long-random-secret>
SUPER_ADMIN_EMAIL=<super-admin-email>
SUPER_ADMIN_INITIAL_PASSWORD=<temporary-strong-password>
AUTH_ALLOWED_EMAIL_DOMAINS=vodacom.co.za,vodacom.com,vcontractor.co.za
REQUIRE_DB_ON_STARTUP=false

# Bundled PostgreSQL container (docker-compose.yml builds the internal URL from these)
POSTGRES_DB=wo_reports
POSTGRES_USER=wo_user
POSTGRES_PASSWORD=<database-password>
# Host publishing; keep 127.0.0.1 unless an external bind is approved.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5434
API_HOST_PORT=8010
# Podman network shared with the Work Order frontend.
WO_NETWORK=wo-net

# Local development only (not needed with the bundled container)
DATABASE_URL=postgresql://wo_user:<database-password>@localhost:5434/wo_reports
DB_CONNECT_TIMEOUT=5
DB_CONNECT_RETRIES=3
DB_RETRY_DELAY_SECONDS=2
DBT_RUN_RETRIES=2
DBT_RETRY_DELAY_SECONDS=5

# BMC Helix
HELIX_BASE_URL=https://vodacom-restapi.onbmc.com
HELIX_USERNAME=<helix-service-account>
HELIX_PASSWORD=<helix-password>
HELIX_VERIFY_SSL=true
HELIX_PROXY_URL=
HELIX_FORM=WOI:WorkOrder
HELIX_DATE_FIELD=Submit Date
HELIX_PAGE_SIZE=1000
HELIX_MAX_RECORDS=50000
HELIX_INCLUDE_YESTERDAY_COMPLETIONS=true
HELIX_USE_INCREMENTAL_WATERMARK=false
HELIX_PERIOD=

# Work Order field names in Helix (confirm against a sample export)
WO_ID_FIELD=Work Order ID
WO_TYPE_FIELD=Work Order Type
WO_CATEGORY_FIELD=Categorization Tier 1
WO_STATUS_FIELD=Status
WO_SUPPORT_GROUP_FIELD=Support Group Name
WO_ASSIGNEE_FIELD=Request Assignee
WO_SUBMIT_DATE_FIELD=Submit Date
WO_TARGET_DATE_FIELD=Scheduled End Date
WO_COMPLETED_DATE_FIELD=Completed Date

# Work Order statuses (comma-separated)
WO_OPEN_STATUSES=Assigned,Pending,Waiting Approval,Planning,In Progress
WO_CLOSED_STATUSES=Completed,Closed
WO_EXCLUDED_STATUSES=Cancelled,Rejected,Draft

# SLA rules: late = past the target date
WO_NEARING_WINDOW_HOURS=24
WO_GRACE_MINUTES=0
WO_DATE_ONLY_END_OF_DAY=true
