# Copy this file to .env.qa on the QA Linux server and adjust the backend URL.

# Recommended for QA: keep browser calls same-origin and let Next proxy /api/*.
NEXT_PUBLIC_API_URL=

# If the backend runs directly on the same Linux host outside Docker, keep this:
API_PROXY_URL=http://host.docker.internal:8000

# If the backend is another Compose service on the same Docker network, use its service name instead:
# API_PROXY_URL=http://api:8000
